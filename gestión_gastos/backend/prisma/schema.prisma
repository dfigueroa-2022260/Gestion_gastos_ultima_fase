generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  USUARIO
}

enum TipoAhorro {
  DEPOSITO
  RETIRO
}

model Usuario {
  id             String      @id @default(uuid())
  nombre         String
  email          String      @unique
  password       String
  rol            Rol         @default(USUARIO)
  resetToken     String?     @unique
  resetTokenExp  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  categorias     Categoria[]
  gastos         Gasto[]
  ingresos       Ingreso[]
  ahorros        Ahorro[]
  etiquetas      Etiqueta[]

  @@map("usuarios")
}

model Etiqueta {
  id              String     @id @default(uuid())
  nombre          String
  color           String     @default("#E8672A")
  icono           String     @default("tag")
  etiquetaPadreId String?
  etiquetaPadre   Etiqueta?  @relation("Subetiquetas", fields: [etiquetaPadreId], references: [id], onDelete: Cascade)
  subetiquetas    Etiqueta[] @relation("Subetiquetas")
  usuarioId       String
  usuario         Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())

  @@unique([usuarioId, nombre])
  @@map("etiquetas")
}

model Categoria {
  id               String      @id @default(uuid())
  nombre           String
  color            String      @default("#E8672A")
  icono            String      @default("tag")
  categoriaPadreId String?
  categoriaPadre   Categoria?  @relation("Subcategorias", fields: [categoriaPadreId], references: [id], onDelete: Cascade)
  subcategorias    Categoria[] @relation("Subcategorias")
  usuarioId        String
  usuario          Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  gastos           Gasto[]
  ingresos         Ingreso[]
  ahorros          Ahorro[]
  createdAt        DateTime    @default(now())

  @@unique([usuarioId, nombre])
  @@map("categorias")
}

model Gasto {
  id          String    @id @default(uuid())
  monto       Decimal   @db.Decimal(10, 2)
  descripcion String?
  fecha       DateTime  @default(now())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("gastos")
}

model Ingreso {
  id          String    @id @default(uuid())
  monto       Decimal   @db.Decimal(10, 2)
  descripcion String?
  fecha       DateTime  @default(now())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ingresos")
}

model Ahorro {
  id          String     @id @default(uuid())
  monto       Decimal    @db.Decimal(10, 2)
  descripcion String?
  fecha       DateTime   @default(now())
  tipo        TipoAhorro @default(DEPOSITO)
  categoriaId String
  categoria   Categoria  @relation(fields: [categoriaId], references: [id])
  usuarioId   String
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("ahorros")
}
